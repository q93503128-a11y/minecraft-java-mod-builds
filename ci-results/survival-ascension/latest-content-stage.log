    "advancements.tbos.enter_fractured_archive.title": "Beyond the Curator's Gate",
    "advancements.tbos.enter_fractured_archive.description": "Enter the Fractured Archive through the Curator Gateway.",
    "journal.tbos.quests.title": "The Archivist's Ledger",
