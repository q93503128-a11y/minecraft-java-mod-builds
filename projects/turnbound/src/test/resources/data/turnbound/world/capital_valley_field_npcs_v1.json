{
  "schemaVersion": 1,
  "npcs": [
    {
      "locator": "turnbound:npc/capital_valley/road_guide",
      "siteLocator": "turnbound:site/capital_valley/first_guide",
      "playerLabel": "길잡이 세라",
      "visualAsset": "DRABYEL_GREETER",
      "dialogue": "탑까지는 큰길을 따라가면 돼. 길가의 짐승과 약탈자는 멀리서도 보이니, 싸우기 싫다면 길 가장자리로 돌아가.",
      "interactionRadius": 4,
      "questOfferFlag": "HIDDEN_CV_SERA_OFFERED",
      "questOfferId": "turnbound:quest/drehmal/hidden_old_waymark",
      "questOfferDialogue": "그런데 탑 아래쪽 돌기둥에 오래된 길표식이 하나 있어. 그냥 지나치기 쉬운데, 아직 남아 있다면 확인해 줄래? 제대로 읽히면 이 길을 다시 쓰는 데 도움이 될 거야."
    },
    {
      "locator": "turnbound:npc/capital_valley/tower_watch",
      "siteLocator": "turnbound:site/capital_valley/tower_watch",
      "playerLabel": "순찰대원 로엔",
      "visualAsset": "DRABYEL_STABLEMASTER",
      "dialogue": "서쪽 경고 동굴 쪽에는 큰 놈이 자리 잡았어. 뉴 드라비엘로 가는 길만 찾는다면 굳이 건드릴 필요는 없어.",
      "interactionRadius": 4,
      "questOfferFlag": "SIDE_CV_ROEN_OFFERED",
      "questOfferId": "turnbound:quest/drehmal/tower_road_clearance",
      "questOfferDialogue": "탑 남쪽 길에 약탈자들이 다시 자리 잡았어. 마을로 갈 생각이라면 한 번 밀어내 줘. 길을 비워 두면 뒤따르는 사람들도 숨통이 트일 거야."
    },
    {
      "locator": "turnbound:npc/capital_valley/camp_explorer",
      "siteLocator": "turnbound:site/capital_valley/camp_explorer",
      "playerLabel": "탐험가 미라",
      "visualAsset": "DRABYEL_STORYKEEPER",
      "dialogue": "여기서부터 마을까지는 순찰대가 자주 보여. 캠프 남쪽 길은 넓지만, 먼저 적의 움직임을 보고 지나가는 편이 좋아.",
      "interactionRadius": 4,
      "questOfferFlag": "HIDDEN_CV_MIRA_OFFERED",
      "questOfferId": "turnbound:quest/drehmal/hidden_camp_night",
      "questOfferDialogue": "밤마다 북쪽 길의 이끼등 무리가 야영지까지 내려와. 지나가는 길이면 한 번 흩어 줘. 다음 탐험대가 훨씬 편해질 거야."
    },
    {
      "locator": "turnbound:npc/avsal/scrap_dealer",
      "siteLocator": "turnbound:site/avsal/scavenger_contact",
      "playerLabel": "폐품상 나라",
      "visualAsset": "DRABYEL_STORYKEEPER",
      "dialogue": "도시가 죽었다고? 물건은 계속 움직여. 며칠 전에도 안쪽에서 금속 울림이 나더니 누군가 상자를 북쪽으로 옮겼어.",
      "interactionRadius": 4,
      "progressFlag": "AVSAL_MQ_AV02_SCAVENGER",
      "progressRequiresFlag": "AVSAL_MQ_AV01_COMPLETE"
    },
    {
      "locator": "turnbound:npc/avsal/shelter_survivor",
      "siteLocator": "turnbound:site/avsal/survivor_shelter",
      "playerLabel": "생존자 렌",
      "visualAsset": "DRABYEL_GREETER",
      "dialogue": "밤이 되면 폐허 깊은 곳에서 같은 간격으로 빛이 번쩍여. 사람들 싸움과는 달라. 북쪽 물가 쪽에서 시작되는 것 같아.",
      "interactionRadius": 4,
      "progressFlag": "AVSAL_MQ_AV02_SURVIVOR",
      "progressRequiresFlag": "AVSAL_MQ_AV01_COMPLETE"
    },
    {
      "locator": "turnbound:npc/drabyel_local/wounded_scout",
      "siteLocator": "turnbound:site/drabyel_local/wounded_scout",
      "playerLabel": "정찰병 하엔",
      "visualAsset": "DRABYEL_STABLEMASTER",
      "dialogue": "마을에서 멀리 나온 것도 아닌데 같은 길을 두 번 돌아왔습니다. 길표식이 멀쩡한데 방향 감각만 틀어지는 느낌이었어요. 북쪽보다 이 주변부터 확인하는 게 좋겠습니다.",
      "interactionRadius": 4,
      "progressFlag": "DRABYEL_LOCAL_SCOUT",
      "progressRequiresFlag": "DRABYEL_LOCAL_ACCEPTED"
    },
    {
      "locator": "turnbound:npc/avsal/road_courier",
      "siteLocator": "turnbound:site/avsal/road_courier",
      "playerLabel": "운송인 데른",
      "visualAsset": "DRABYEL_STABLEMASTER",
      "dialogue": "이 길은 전보다 더 시끄러워졌어. 잿빛 사냥개가 짐 냄새를 따라오고, 앞선 수레 하나는 아직 돌아오지 않았어. 폐허 가까이에는 녹슨 파수기까지 움직이고 있지.",
      "interactionRadius": 4,
      "progressRequiresFlag": "AVSAL_MQ_AV01_BRIEFED",
      "questOfferFlag": "AVSAL_ROAD_COURIER_OFFERED",
      "questOfferId": "SQ_AV02_RELAY_SENTRIES",
      "questOfferDialogue": "아브살로 계속 갈 거라면 세 가지를 기억해 둬. 사냥개 무리는 길에서 떼어 놓고, 뒤집힌 수레가 보이면 흔적을 확인해 줘. 폐허 접근로의 파수기는 가능하면 정리해 줬으면 해. 가도 밖의 큰 그림자는 굳이 건드리지 않아도 되지만, 잡을 수 있다면 운송대가 훨씬 편해질 거야."
    },
    {
      "locator": "turnbound:npc/avsal/contract_broker",
      "siteLocator": "turnbound:site/avsal/contract_broker",
      "playerLabel": "의뢰 중개인 사엘",
      "visualAsset": "DRABYEL_STORYKEEPER",
      "dialogue": "외곽에 남아 있는 사람들끼리 필요한 일을 모아 두고 있어요. 마을까지 돌아가지 않아도 여기서 지역 의뢰를 받고 보고할 수 있습니다.",
      "interactionRadius": 4,
      "progressRequiresFlag": "AVSAL_REGION_DISCOVERED"
    },
    {
      "locator": "turnbound:npc/avsal/road_guard",
      "siteLocator": "turnbound:site/avsal/road_guard",
      "playerLabel": "가도 경비병 유라",
      "visualAsset": "DRABYEL_GREETER",
      "dialogue": "여기부터 길이 여러 갈래로 찢어져. 정면으로 가도 되지만 약탈대가 길목을 보고 있어. 서두르지 않으면 돌아갈 길도 있어.",
      "interactionRadius": 4,
      "progressFlag": "",
      "progressRequiresFlag": "AVSAL_MQ_AV01_BRIEFED",
      "questOfferFlag": "AVSAL_SQ_ROADBLOCK_OFFERED",
      "questOfferId": "SQ_AV05_ROADBLOCK",
      "questOfferDialogue": "갈림길 약탈대가 운송대를 계속 끊어 먹고 있어. 지나가는 김에 놈들을 밀어내면 다음 수레가 움직일 수 있어."
    },
    {
      "locator": "turnbound:npc/avsal/escort_survivor",
      "siteLocator": "turnbound:site/avsal/escort_survivor",
      "playerLabel": "운송대원 비엔",
      "visualAsset": "DRABYEL_STABLEMASTER",
      "dialogue": "우리 호송대는 앞쪽 매복에 걸렸어. 짐은 포기해도 되지만 아직 길 한복판에 사람들이 묶여 있어.",
      "interactionRadius": 4,
      "progressFlag": "",
      "progressRequiresFlag": "AVSAL_MQ_AV01_BRIEFED",
      "questOfferFlag": "AVSAL_SQ_ESCORT_OFFERED",
      "questOfferId": "SQ_AV06_BROKEN_ESCORT",
      "questOfferDialogue": "무너진 호송로의 매복대를 정리해 줘. 우리가 다친 사람부터 뒤로 빼낼 수 있게."
    },
    {
      "locator": "turnbound:npc/avsal/waymark_keeper",
      "siteLocator": "turnbound:site/avsal/waymark_keeper",
      "playerLabel": "길표식지기 토렌",
      "visualAsset": "DRABYEL_STORYKEEPER",
      "dialogue": "낡은 표식 주변에 이상한 것들이 붙기 시작했어. 길을 아는 사람들은 피해서 가지만 처음 오는 사람은 그대로 걸려들지.",
      "interactionRadius": 4,
      "progressFlag": "",
      "progressRequiresFlag": "AVSAL_MQ_AV01_BRIEFED",
      "questOfferFlag": "AVSAL_SQ_WAYMARK_OFFERED",
      "questOfferId": "SQ_AV07_WAYMARK",
      "questOfferDialogue": "길표식 주변의 망자들을 치워 줘. 표식을 다시 세우기 전에 주변부터 안전하게 만들고 싶어."
    },
    {
      "locator": "turnbound:npc/avsal/outskirts_hunter",
      "siteLocator": "turnbound:site/avsal/outskirts_hunter",
      "playerLabel": "사냥꾼 메르",
      "visualAsset": "DRABYEL_GREETER",
      "dialogue": "아브살 냄새를 맡은 사냥개들이 이 근처에 눌러앉았어. 폐허를 드나드는 사람들을 따라붙는 법을 배운 놈들이야.",
      "interactionRadius": 4,
      "progressFlag": "",
      "progressRequiresFlag": "AVSAL_MQ_AV01_BRIEFED",
      "questOfferFlag": "AVSAL_SQ_OUTSKIRT_HUNT_OFFERED",
      "questOfferId": "SQ_AV08_OUTSKIRT_HUNT",
      "questOfferDialogue": "외곽 풀숲의 사냥개 무리를 없애 줘. 놈들이 남아 있으면 여기서 쉬는 사람도 오래 못 버텨."
    }
  ]
}
