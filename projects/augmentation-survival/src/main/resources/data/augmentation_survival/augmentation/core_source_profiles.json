    "event_redirects": [
      {
        "selector": "minecraft:elder_guardian",
        "event_profile": "elder_guardian",
        "suppress_normal_mob_roll": true
      },
      {
        "selector": "minecraft:warden",
        "event_profile": "warden",
        "suppress_normal_mob_roll": true
      }
    ],
    "boss_redirects": [
      {
        "selector": "minecraft:wither",
        "suppress_normal_mob_roll": true
      },
      {
        "selector": "minecraft:ender_dragon",
        "suppress_normal_mob_roll": true
      }
    ],
    "dynamic_adapters": [
      {
        "id": "mcendgame_elite",
        "required_mod": "mcendgame",
        "accessor_class": "de.fuballer.mcendgame.main.accessor.LivingEntityEliteAccessor",
        "boolean_method": "mcendgame$isElite",
        "mob_profile": "elite_hostile"
      },
      {
        "id": "mcendgame_loot_goblin",
        "required_mod": "mcendgame",
        "accessor_class": "de.fuballer.mcendgame.main.accessor.LivingEntityLootGoblinAccessor",
        "boolean_method": "mcendgame$isLootGoblin",
        "mob_profile": "elite_hostile"
      },
      {
        "id": "mcendgame_dungeon_enemy",
        "required_mod": "mcendgame",
        "accessor_class": "de.fuballer.mcendgame.main.accessor.LivingEntityDungeonEnemyAccessor",
        "boolean_method": "mcendgame$isDungeonEnemy",
        "mob_profile": "special_hostile"
      }
    ],
    "namespace_default": [
      {
        "namespace": "friendsandfoes",
        "mob_profile": "normal_hostile",
        "condition": "server_classified_hostile_only",
        "reason": "Non-hostile Friends&Foes entities never become core sources."
      },
      {
        "namespace": "illagerinvasion",
        "mob_profile": "special_hostile",
        "condition": "server_classified_hostile_only",
        "reason": "Combat-focused Illager Invasion hostiles are intentionally better core sources than ordinary overworld enemies."
      },
      {
        "namespace": "chronodawn",
        "mob_profile": "progression_hostile",
        "condition": "server_classified_hostile_only",
        "reason": "Hostiles in the dedicated Chrono Dawn progression path should contribute cores without replacing structures and bosses."
      },
      {
        "namespace": "worldbosses",
        "mob_profile": "progression_hostile",
        "condition": "server_classified_hostile_only",
        "reason": "Worldbreaker-realm and boss-mod hostiles should remain relevant to the augmentation loop while recognized bosses use direct rewards."
      }
    ],
    "namespace_exclusions": [
      {
        "namespace": "naturalist",
        "reason": "Ordinary wildlife must not become a core farming route."
      }
    ],
    "global_fallback": {
      "condition": "server_classified_hostile",
      "mob_profile": "normal_hostile"
    }
  },
