  "density_and_duplication_rules": {
    "apply_multiplier_to_core_roll_chance_not_item_count": true,
    "max_one_additional_core_roll_per_natural_container": true,
    "already_consumed_natural_loot_container_cannot_reseed": true,
    "player_placed_or_copied_container_cannot_gain_natural_core_roll": true,
    "high_density_modded_structures_should_prefer_multiplier_below_one": true,
    "single_key_cache_may_use_multiplier_above_one": true
  },
  "verification_notes": {
    "friendsandfoes": "Exact hostile IDs iceologer, illusioner, mauler, and wildfire were verified from the public FriendsAndFoesEntityTypes registration source during the 2026-10-24 audit.",
    "illagerinvasion": "The 26.2.x branch and combat entity resource names were inspected, but exact registry registration IDs were not treated as verified; namespace fallback is intentional.",
    "repurposed_structures": "Use namespace and semantic path-family matching instead of an exhaustive generated-variant list; exact variant IDs are deliberately not required for baseline resolution.",
    "dungeons_and_taverns": "The public 26.2 data pack uses namespace nova_structures for structure/loot data. Runtime source matching supports nova_structures directly; the historical mr_dungeons_andtaverns identifier remains as a compatibility alias.",
    "chronodawn": "All eight managed structure IDs were verified from Chrono Dawn's shared ManagedStructure source; only these authored progression structures receive structure-core rolls, so renewable/microstructure loot is not promoted into a core farm.",
    "mcendgame": "Pinned runtime accessors for dungeon-enemy, elite, loot-goblin and dungeon-boss flags were verified from the public MCEndgame source; dynamic state takes precedence over underlying vanilla entity type.",
    "boss_mods": "External boss rewards are keyed by the already-validated compatibility profile IDs rather than guessed registry IDs."
  }
}
