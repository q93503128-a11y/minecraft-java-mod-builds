{
  "schema_version": 2,
  "status": "canonical-external-content-integration-baseline",
  "runtime_active": true,
  "purpose": "Map structure, hostile, event, and boss sources onto the canonical core distribution and boss reward contracts without hardcoding balance weights in runtime code.",
  "contract_refs": {
    "distribution": "augmentation_survival:augmentation/core_distribution_contract.json",
    "boss_rewards": "augmentation_survival:augmentation/boss_core_reward_contract.json"
  },
  "selector_precedence": [
    "event_or_boss_redirect",
    "dynamic_runtime",
    "exact",
    "path_prefix",
    "namespace_default",
    "global_fallback"
  ],
  "resolution_rules": {
    "first_match_wins": true,
    "balance_weights_live_only_in_contracts": true,
    "unknown_structure_default": "no_core_source",
    "unknown_hostile_default": "normal_hostile_if_server_classifies_as_hostile",
    "unknown_boss_default": "no_direct_boss_reward_until_adapter_classifies_encounter",
    "unverified_exact_ids_are_never_guessed": true
  },
  "structure_sources": {
    "exact": [
      {
        "selector": "minecraft:buried_treasure",
        "distribution_profile": "routine_exploration",
        "core_roll_multiplier": 2.0,
        "reason": "Single-cache exploration reward; compensate for one-container density."
      },
      {
        "selector": "minecraft:ancient_city",
        "distribution_profile": "dangerous_high",
        "core_roll_multiplier": 0.65,
        "reason": "Very high danger but many containers; density correction prevents a single city becoming a core factory."
      },
      {
        "selector": "minecraft:mansion",
        "distribution_profile": "dangerous_high",
        "core_roll_multiplier": 0.75,
        "reason": "Large combat structure with multiple loot opportunities."
      },
      {
        "selector": "minecraft:end_city",
        "distribution_profile": "dangerous_high",
        "core_roll_multiplier": 0.8,
        "reason": "Late exploration structure with multiple containers and strong traversal pressure."
      },
      {
        "selector": "chronodawn:ancient_ruins",
        "distribution_profile": "routine_exploration",
        "core_roll_multiplier": 1.0,
        "reason": "Verified Chrono Dawn overworld entry structure."
      },
      {
        "selector": "chronodawn:forgotten_library",
        "distribution_profile": "dangerous_mid",
        "core_roll_multiplier": 0.75,
        "reason": "Verified Chrono Dawn progression structure with multiple loot opportunities."
      },
      {
        "selector": "chronodawn:desert_clock_tower",
        "distribution_profile": "dangerous_high",
        "core_roll_multiplier": 0.55,
        "reason": "Boss-gated Chrono Dawn structure; chest rewards supplement rather than replace the guaranteed boss core."
      },
      {
        "selector": "chronodawn:guardian_vault",
        "distribution_profile": "dangerous_high",
        "core_roll_multiplier": 0.55,
        "reason": "Boss-gated Chrono Dawn structure; density correction prevents double-paying the encounter."
      },
      {
        "selector": "chronodawn:clockwork_depths",
        "distribution_profile": "dangerous_high",
        "core_roll_multiplier": 0.55,
        "reason": "Boss-gated Chrono Dawn structure; density correction prevents double-paying the encounter."
      },
      {
        "selector": "chronodawn:phantom_catacombs",
        "distribution_profile": "dangerous_high",
        "core_roll_multiplier": 0.55,
        "reason": "Boss-gated Chrono Dawn structure; density correction prevents double-paying the encounter."
      },
      {
        "selector": "chronodawn:entropy_crypt",
        "distribution_profile": "dangerous_high",
        "core_roll_multiplier": 0.55,
        "reason": "Boss-gated Chrono Dawn structure; density correction prevents double-paying the encounter."
      },
      {
        "selector": "chronodawn:master_clock",
        "distribution_profile": "dangerous_high",
        "core_roll_multiplier": 0.40,
        "reason": "Final-boss structure chests remain a bonus; direct Time Tyrant rewards carry the encounter progression."
      }
    ],
    "path_prefix": [
      {
        "namespace": "minecraft",
        "prefixes": ["mineshaft", "shipwreck", "ruined_portal", "ocean_ruin", "trail_ruins", "igloo"],
        "distribution_profile": "routine_exploration",
        "core_roll_multiplier": 1.0
      },
      {
        "namespace": "minecraft",
        "prefixes": ["desert_pyramid", "jungle_pyramid", "pillager_outpost", "fortress", "stronghold", "trial_chambers"],
        "distribution_profile": "dangerous_mid",
        "core_roll_multiplier": 1.0
      },
      {
        "namespace": "minecraft",
        "prefixes": ["bastion_remnant"],
        "distribution_profile": "dangerous_high",
        "core_roll_multiplier": 0.8
      },
      {
        "namespace": "minecraft",
        "prefixes": ["village"],
        "excluded": true,
        "reason": "Safe, dense civilian storage is not a primary core source."
      },
      {
        "namespace": "repurposed_structures",
        "prefixes": ["mineshaft", "shipwreck", "ruined_portal", "ocean_ruin"],
        "distribution_profile": "routine_exploration",
        "core_roll_multiplier": 1.0
      },
      {
        "namespace": "repurposed_structures",
        "prefixes": ["stronghold", "fortress", "pyramid", "outpost", "temple"],
        "distribution_profile": "dangerous_mid",
        "core_roll_multiplier": 0.9
      },
      {
        "namespace": "repurposed_structures",
        "prefixes": ["mansion", "bastion", "ancient_city", "end_city"],
        "distribution_profile": "dangerous_high",
        "core_roll_multiplier": 0.75
      },
      {
        "namespace": "repurposed_structures",
        "prefixes": ["village"],
        "excluded": true,
        "reason": "Inherit the vanilla village anti-farm policy."
      },
      {
        "namespace": "mr_dungeons_andtaverns",
        "prefixes": ["tavern", "small", "camp"],
        "distribution_profile": "routine_exploration",
        "core_roll_multiplier": 0.8
      },
      {
        "namespace": "mr_dungeons_andtaverns",
        "prefixes": ["outpost", "dungeon"],
        "distribution_profile": "dangerous_mid",
        "core_roll_multiplier": 0.7
      },
      {
        "namespace": "mr_dungeons_andtaverns",
        "prefixes": ["fort", "large", "deep"],
        "distribution_profile": "dangerous_high",
        "core_roll_multiplier": 0.6
      },
      {
        "namespace": "nova_structures",
        "prefixes": ["tavern", "small", "camp"],
        "distribution_profile": "routine_exploration",
        "core_roll_multiplier": 0.8,
        "reason": "Verified Dungeons and Taverns data namespace."
      },
      {
        "namespace": "nova_structures",
        "prefixes": ["outpost", "dungeon", "crypt", "ruin"],
        "distribution_profile": "dangerous_mid",
        "core_roll_multiplier": 0.7,
        "reason": "Verified Dungeons and Taverns data namespace."
      },
      {
        "namespace": "nova_structures",
        "prefixes": ["fort", "large", "deep"],
        "distribution_profile": "dangerous_high",
        "core_roll_multiplier": 0.6,
        "reason": "Verified Dungeons and Taverns data namespace."
      }
    ],
    "namespace_default": [
      {
        "namespace": "repurposed_structures",
        "distribution_profile": "dangerous_mid",
        "core_roll_multiplier": 0.85,
        "reason": "Unclassified generated variants remain useful without requiring a brittle exhaustive ID list."
      },
      {
        "namespace": "mr_dungeons_andtaverns",
        "distribution_profile": "dangerous_mid",
        "core_roll_multiplier": 0.65,
        "reason": "Dense structure pack default; individual high or low risk families override this."
      },
      {
        "namespace": "nova_structures",
        "distribution_profile": "dangerous_mid",
        "core_roll_multiplier": 0.65,
        "reason": "Verified Dungeons and Taverns data namespace; dense-pack default until individual families are measured."
      },
      {
        "namespace": "illagerinvasion",
        "distribution_profile": "dangerous_mid",
        "core_roll_multiplier": 0.8,
        "reason": "Combat-oriented added structure loot uses the middle-risk baseline until exact structures are measured."
      }
    ],
    "namespace_exclusions": [
      {
        "namespace": "terralith",
        "reason": "Biome/worldgen context only; cores come from contained structures and encounters, not the biome namespace itself."
      },
      {
        "namespace": "naturalist",
        "reason": "Wildlife/world context is not a structure core source."
      },
      {
        "namespace": "farmersdelight",
        "reason": "Normal production content does not generate progression cores."
      }
    ]
  },
