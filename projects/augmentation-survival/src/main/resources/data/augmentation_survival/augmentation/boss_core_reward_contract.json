  "sources": [
    {
      "mod_id": "chronodawn",
      "display_name": "Chrono Dawn",
      "content_summary": "Dedicated time-themed dimension with six authored bosses.",
      "known_major_boss_count": 6,
      "integration_method": "shared entity compatibility profiles backed by exact 26.2 boss IDs",
      "source_edit_policy": "allowed_when_needed",
      "license": "LGPL-3.0",
      "default_reward_band": "boss_major",
      "assignment_policy": "all six verified bosses start major; individual promotion waits for live encounter measurement"
    },
    {
      "mod_id": "worldbosses",
      "display_name": "World Bosses",
      "content_summary": "World shrines, raid caches, a boss dimension, and eleven major boss encounters in the current 2.0.2 content set.",
      "known_major_boss_count": 11,
      "integration_method": "shared runtime-resolved World Bosses compatibility profiles; no third-party JAR modification",
      "source_edit_policy": "do_not_modify_or_redistribute_third_party_jar",
      "license": "All Rights Reserved",
      "default_reward_band": "boss_major",
      "assignment_policy": "all eleven verified boss profiles start major; pinnacle promotion requires measured gameplay evidence"
    },
    {
      "mod_id": "mcendgame",
      "display_name": "MCEndgame",
      "content_summary": "Repeatable generated endgame dungeons with dynamically flagged dungeon bosses and a pinnacle Beastweaver progression path.",
      "known_major_boss_count": "runtime dungeon-boss encounters",
      "integration_method": "shared dynamic compatibility adapter using MobEntityDungeonBossAccessor#mcendgame$isDungeonBoss",
      "source_edit_policy": "allowed_when_needed",
      "license": "LGPL-3.0-or-later",
      "default_reward_band": "boss_major",
      "pinnacle_candidate": "Beastweaver",
      "repeat_policy": "generic repeatable dungeon bosses stay major; a separate pinnacle identity is required before direct mythic weights are enabled"
    }
  ],
  "global_rules": {
    "server_authoritative": true,
    "preserve_original_boss_rewards": true,
    "per_player_reward": true,
    "one_fixed_core_grade_per_boss": false,
    "first_kill_bonus_is_per_player_per_authored_boss_profile": true,
    "default_first_kill_bonus_core_count": 1,
    "repeatable_pinnacle_direct_mythic_rate": 0.05,
    "general_loot_multipliers_affect_boss_cores": false,
    "companion_only_kill_grants_direct_boss_reward": false,
    "participant_eligibility": "server-side successful-damage participation plus player final-killer inclusion; rewards are personal inventory grants",
    "external_boss_generic_mob_roll_suppressed": true,
    "design_details": "see CORE_ACQUISITION_DESIGN_2026-10-24.md"
  }
