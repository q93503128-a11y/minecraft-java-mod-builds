# Pixel-accurate ellipsis and a stacked fallback on exceptionally narrow town-hall layouts.
town = JAVA / "VillageTownHallScreen.java"
replace_once(town, "compact(role.name(), Math.max(10, w / 6))", "compact(role.name(), w - 22)")
