{
  "schemaVersion": 1,
  "id": "openworld_rpg",
  "version": "${version}",
  "name": "Open-World RPG",
  "description": "An authored open-world fantasy action RPG built on Minecraft Java.",
  "authors": ["MoonSeungJun"],
  "license": "All-Rights-Reserved",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.moonseungjun.openworldrpg.OpenworldRpgMod"
    ]
  },
  "mixins": [
    "openworld_rpg.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": ">=0.160.0"
  },
  "recommends": {
    "player_animation_library": "*",
    "geckolib": "*",
    "armor_model_api": "*",
    "ranged_weapon_api": "*",
    "trinkets_updated": "*",
    "bettercombat": "*",
    "spell_engine": "*",
    "spell_power": "*",
    "cloth-config": "*",
    "mobfilter": "*",
    "alexsmobs": "*",
    "codxlib": "*",
    "threateningly_mobs": "*"
  }
}
